# Cable lay vessel propulsion study - Option 1: Azimuth thruster option
# Hull, positions and system setup from config_csov (Norwind SOV hull used for both options).
# ESTIMATES - replace with maker data:
#  - Low speed thrust scaled with T ~ (P*D)^(2/3) from reference thrusters.
#  - Wake fraction / thrust deduction are typical values, not model test data.
# Order matters: power_system.prototxt thruster_index refers to this order.

propulsor {
  name: "Bow Tunnel Thruster 1"
  short_name: "BT1"
  position {
    x_position: 42.813
    y_position: 0.0
    z_position: 4.2
  }
  tunnel {
    details {
      propeller_diameter: 2.6
      nozzle: false
      variable_pitch: true
      variable_rpm: true
      thrust_power_data {
        max_positive_thrust: 244.0
        max_negative_thrust: -244.0
        max_power_positive_thrust: 1700.0
        max_power_negative_thrust: 1700.0
        max_zero_thrust_power: 0.0
      }
    }
  }
  dp_interface {
    control_signal: ThrustControl
    redundant_nmea_serial {
      main_controller_name: "io-a"
      main_com_port_index: 10
      backup_controller_name: "io-b"
      backup_com_port_index: 10
    }
  }
}
