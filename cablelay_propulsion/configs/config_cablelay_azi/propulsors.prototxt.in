propulsor {
  name: "Bow Retractable Thruster"
  short_name: "BR"
  position {
    x_position: 33.99
    y_position: 0.0
    z_position: 8.66 # From CSOV: guess based on travel length and draft
  }
  azimuth {
    details {
      propeller_diameter: 2.4
      nozzle: true
      variable_pitch: false
      variable_rpm: true
      thrust_power_data {
        max_positive_thrust: 307.0
        max_negative_thrust: 0.0
        max_power_positive_thrust: 1600.0
        max_power_negative_thrust: 1600.0
        max_zero_thrust_power: 0.0
      }
    }
  }
  dp_interface {
    control_signal: ThrustControl
    redundant_nmea_serial {
      main_controller_name: "io-a"
      main_com_port_index: 12
      backup_controller_name: "io-b"
      backup_com_port_index: 12
    }
  }
}
propulsor {
  name: "Port Main Azimuth"
  short_name: "AZ1"
  position {
    x_position: -48.09
    y_position: -5.4
    z_position: 4.2
  }
  azimuth {
    details {
      propeller_diameter: 3.3
      nozzle: true # Ducted (standard for CLVs)
      variable_pitch: false # Fixed pitch, variable speed electric drive
      variable_rpm: true
      thrust_power_data { # Fixed pitch, net bollard thrust (equal to shaft line, incl. housing / interaction loss). No reverse: azimuth rotates.
        max_positive_thrust: 459.0
        max_negative_thrust: 0.0
        max_power_positive_thrust: 3000.0
        max_power_negative_thrust: 3000.0
        max_zero_thrust_power: 0.0
      }
    }
    azimuth_details {
      pulling: false
    }
  }
  dp_interface {
    control_signal: RpmControl
    redundant_nmea_serial {
      main_controller_name: "io-a"
      main_com_port_index: 13
      backup_controller_name: "io-b"
      backup_com_port_index: 13
    }
  }
}
