# Offshore structures for CSOV wind farm operations
# Values based on Hollandse Kust Noord wind farm reference data
#
# 3x4 grid of wind turbines, ~400m spacing
# Base position: lat 62.688913, lon 6.982234
# At lat ~62.7: 400m north ~ 0.003593 deg, 400m east ~ 0.007834 deg
# Random position offsets ~20m, random azimuth offsets ~5 deg
#
# Landing point positions are relative to the structure rotation point (tower center).

wind_turbine_types {
  id: 1
  name: "HKN"
  safety_zone_radius: 150
  tower_diameter: 7.1
  geometry {
    length: 12.6
    width: 9.199
    bounding_box_x_offset: -1.7
    bounding_box_y_offset: 0.0
    outline_name: "hollandse_kust_noord_wind_turbine"
  }
  landing_points {
    name: "LP1"
    position {
      x_position: 3.889
      y_position: -4.5995
    }
    normal_angle: 270
  }
  landing_points {
    name: "LP2"
    position {
      x_position: 8.0
      y_position: 0
    }
    normal_angle: 0
  }
  landing_points {
    name: "LP3"
    position {
      x_position: 4.059
      y_position: 4.5995
    }
    normal_angle: 90
  }
}

offshore_structures {
  name: "SF A01"
  position {
    latitude: 62.688913
    longitude: 6.982234
  }
  as_built_azimuth: 63.2
  wind_turbine {
    wind_turbine_type_id: 1
  }
}

