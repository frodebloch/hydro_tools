propulsor {
  name: "Port Main Propeller"
  short_name: "MP1"
  position {
    x_position: -46.0
    y_position: -4.5
    z_position: 4.2
  }
  main_propeller {
    details {
      propeller_diameter: 3.0
      nozzle: true
      variable_pitch: false # Fixed pitch, variable speed electric drive
      variable_rpm: true
      thrust_power_data { # Fixed pitch D-series design A: 540 kN gross x (1 - t 0.15) = 459 kN net. Astern 60% of ahead (reversing motor, to be confirmed).
        max_positive_thrust: 459.0
        max_negative_thrust: -275.0
        max_power_positive_thrust: 3000.0
        max_power_negative_thrust: 3000.0
        max_zero_thrust_power: 0.0
      }
    }
  }
  dp_interface {
    control_signal: PitchRpmControl
    redundant_nmea_serial {
      main_controller_name: "io-a"
      main_com_port_index: 13
      backup_controller_name: "io-b"
      backup_com_port_index: 13
    }
  }
}
