propulsor {
  name: "Bow Retractable Thruster"
  short_name: "BR"
  position {
    x_position: 33.99
    y_position: 0.0
    z_position: 8.66 # From CSOV: guess based on travel length and draft
  }
  azimuth {
    details {
      propeller_diameter: 2.4
      nozzle: true
      variable_pitch: false
      variable_rpm: true
      thrust_power_data {
        max_positive_thrust: 307.0
        max_negative_thrust: 0.0
        max_power_positive_thrust: 1600.0
        max_power_negative_thrust: 1600.0
        max_zero_thrust_power: 0.0
      }
    }
  }
  dp_interface {
    control_signal: ThrustControl
    redundant_nmea_serial {
      main_controller_name: "io-a"
      main_com_port_index: 12
      backup_controller_name: "io-b"
      backup_com_port_index: 12
    }
  }
}
# Stern tunnels: 1500 kW on D1.5 m is ~850 kW/m2 - very high loading, verify with maker.
propulsor {
  name: "Stern Tunnel Thruster 1"
  short_name: "ST1"
  position {
    x_position: -38.65
    y_position: 0.0
    z_position: 4.2
  }
  tunnel {
    details {
      propeller_diameter: 1.5
      nozzle: false
      variable_pitch: true
      variable_rpm: true
      thrust_power_data {
        max_positive_thrust: 100.8 # Stern tube blockage: 35% loss on 155 kN unblocked
        max_negative_thrust: -100.8
        max_power_positive_thrust: 1500.0
        max_power_negative_thrust: 1500.0
        max_zero_thrust_power: 0.0
      }
    }
  }
  dp_interface {
    control_signal: ThrustControl
    redundant_nmea_serial {
      main_controller_name: "io-a"
      main_com_port_index: 15
      backup_controller_name: "io-b"
      backup_com_port_index: 15
    }
  }
}
