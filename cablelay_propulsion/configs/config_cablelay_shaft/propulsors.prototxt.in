propulsor {
  name: "Port Rudder"
  short_name: "RD1"
  position {
    x_position: -48.5
    y_position: -4.5
    z_position: 4.2
  }
  rudder {
    type: FLAP
    area: 6.9 # Scaled from config_ahts (8.05 m2 behind D3.5)
    height: 3.2
    max_rudder_angle: 45.0
  }
  dp_interface {
    controller_name: "io-a"
    hardwired_rudder {
      di {
        in_dp_command: "A1.4.2.2"
      }
      ai {
        rudder_angle: "A1.1.2.2"
      }
      ao {
        rudder_setpoint: "A1.3.1.0"
      }
    }
  }
}
propulsor {
  name: "Starboard Rudder"
  short_name: "RD2"
