\geometry{left=25.4mm, textwidth=165.1mm, top=25.4mm, bottom=25.4mm}
% ** Header and footer setup
% *** Define new page styles with boxed header and footer
\newcommand{\ps@mtsBanners}{%
  % New heading style
  \renewcommand{\@oddhead}{%
    \begin{minipage}[c]{\textwidth}
      \setlength{\extrarowheight}{1.5pt}
      \begin{tabular}{%
          m{60mm}@{}%
          @{}>{\centering}p{45.1mm}@{}%
          @{}>{\centering}p{60mm}%
        }
        \sffamily\small\mtsAuthor{}
        & \sffamily\small\mtsType{}
        & \sffamily\small\mtsTitle{}
        \tabularnewline
          \hline
      \end{tabular}
    \end{minipage}
  }% End \@oddhead
  % New footer style
  \renewcommand{\@oddfoot}{%
    \begin{minipage}{\textwidth}
      \vspace{0.2cm}
      \setlength{\extrarowheight}{0.5pt}
     \begin{tabular}{  p{6.0cm}  p{8.1cm}  p{1.0cm}}%
        \hline%
        \sffamily\small{MTS DP Conference - Houston} & \sffamily\small{October 13-14, 2026} & \sffamily\small{Page \thepage\ } \\
        % of \pageref{LastPage} \\
      \end{tabular}
    \end{minipage}
  }% End \@oddfoot
  \renewcommand{\@evenhead}{\@oddhead}
  \renewcommand{\@evenfoot}{\@oddfoot} } \pagestyle{mtsBanners}

% Logo insertion command
\newcommand*{\mtsLogo}[1][]{%
  \includegraphics[#1]{images/mts}
}

% Title page
\newenvironment{mtsTitlepage}{\mbox{}\hfill
}{}
\newcommand{\mtsMainTitlePage}[1][]{%
\thispagestyle{empty}
\begin{mtsTitlepage}
  \begin{center}
    \mtsLogo[width=120mm]%
    \medskip
    \\\sffamily\small\textbf{DYNAMIC POSITIONING CONFERENCE}
    \\\sffamily\small\textbf{October 13-14, 2026}
  \end{center}
  \begin{minipage}{150mm}
    \medskip
    \medskip
    \medskip
    \medskip
      \begin{center}
        {\color{Blue}\sffamily\large\bfseries\mtsType}%
        \\[\baselineskip]%
        \rule{90mm}{0.3mm}%
        \medskip
        \\{\sffamily\textbf{\color{Blue}\Large\bfseries\mtsTitle}}%
        \\[\baselineskip]%
        \\\color{Blue}{ \sffamily\large\bfseries{By \mtsAuthor}}%
        \\[\baselineskip]%
        \\\color{Blue}{\sffamily\large\bfseries{\mtsCompany}}%
        \\\color{Black}\rule{90mm}{0.3mm}%
        \\%
        \vfill%
        \mbox{}%    
      \end{center}%
    \end{minipage}
    \cleardoublepage
  \end{mtsTitlepage}
  %\setcounter{page}{1}
}

